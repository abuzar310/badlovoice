# Google Drive upload — OAuth user (works with personal Gmail My Drive)
# 1) Enable Google Drive API
# 2) Create OAuth client (Desktop) → secrets/gdrive-oauth-client.json
# 3) Create a Drive folder; put its ID below (from the folder URL)
# 4) First upload opens a browser to authorize; token saved to secrets/gdrive-oauth-token.json
GDRIVE_FOLDER_ID=
GDRIVE_OAUTH_CLIENT=secrets/gdrive-oauth-client.json
GDRIVE_OAUTH_TOKEN=secrets/gdrive-oauth-token.json

# Service account only works with Workspace Shared Drives (not personal My Drive):
# GOOGLE_APPLICATION_CREDENTIALS=secrets/gdrive-service-account.json

# ---------------------------------------------------------------------------
# Backend (backend/config.py). All optional; the defaults are shown.
# ---------------------------------------------------------------------------
# Address used by `python -m backend.main`. Loopback only by default: the API
# has no login and can load model files. Set 0.0.0.0 only on a network you
# trust. (With `uvicorn ... --host --port` those flags decide instead.)
# SHIFTBOOTH_HOST=127.0.0.1
# SHIFTBOOTH_PORT=8000

# Extra web origins allowed to call the API, as a JSON list. Pages served by
# the backend itself, or from this machine (the Vite dev server), never need
# listing. Needed e.g. behind a reverse proxy that rewrites the Host header.
# SHIFTBOOTH_CORS_ORIGINS=["https://voice.example.com"]

# SHIFTBOOTH_MODELS_DIR=models
# SHIFTBOOTH_HUBERT_PATH=models/assets/hubert_base.pt
# SHIFTBOOTH_RMVPE_ROOT=models/assets/rmvpe
# SHIFTBOOTH_LOG_LEVEL=info
